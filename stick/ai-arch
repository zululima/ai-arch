#!/usr/bin/env bash
# Runs on the Arch live system. cloud-init calls it once with --prepare to
# install Claude Code, the Claude desktop app and Chrome and open the two; ai-arch
# opens them again, and ai-arch --console runs Claude Code on the console instead.
set -uo pipefail

export HOME=/root
workdir=/root/ai-arch
token_copy=/run/ai-arch/token
desktop_ready=/run/ai-arch/desktop-ready
desktop_user=claude
desktop_repo=https://downloads.claude.ai/claude-desktop
# Anthropic's apt signing key, as the Claude Desktop on Linux docs give it.
desktop_key_fpr=31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE
chrome_repo=https://dl.google.com/linux
# Google's Linux package signing key; it signs with subkeys, and gpg's VALIDSIG
# line names this primary key too.
chrome_key_fpr=EB4C1BFD4F042F6DDDCCEC917721F63BD38B4796
# Claude in Chrome in the Chrome Web Store.
chrome_extension=fcoeoabgfenejglbffodgkkbkcdhcgfn
# Arch names for what the app's .deb depends on, without the virtual machine
# that only Cowork uses, then what the AUR's google-chrome adds to them.
desktop_packages=(
  sway xorg-xwayland sudo ttf-dejavu gtk3 nss alsa-lib at-spi2-core libcups libnotify
  libsecret libxtst libpipewire mesa bubblewrap socat libseccomp libcap-ng xdg-utils
  xdg-desktop-portal xdg-desktop-portal-gtk libxss ttf-liberation
)

conf() { sed -n "s/^$1=//p" /etc/ai-arch.conf 2>/dev/null; }

online() { curl -fsS --max-time 10 -o /dev/null https://claude.ai/install.sh; }

install_claude() {
  command -v claude >/dev/null && return 0
  online || return 1
  curl -fsSL https://claude.ai/install.sh | bash || return 1
  ln -sf /root/.local/bin/claude /usr/local/bin/claude
}

# Takes the newest version of a package from an apt repository, checked the way
# apt checks it: InRelease signed by the pinned key, Packages and the .deb by
# sha256. Arguments: repository, key URL, key fingerprint, package.
install_deb() (
  set -e
  apt=$1 key=$2 fpr=$3 package=$4
  tmp=$(mktemp -d)
  trap 'gpgconf --homedir "$tmp/gnupg" --kill all 2>/dev/null; rm -rf "$tmp"' EXIT
  curl -fsSL -o "$tmp/key.asc" "$key"
  curl -fsSL -o "$tmp/InRelease" "$apt/dists/stable/InRelease"
  mkdir -m 700 "$tmp/gnupg"
  gpg --homedir "$tmp/gnupg" --quiet --import "$tmp/key.asc"
  status=$(gpg --homedir "$tmp/gnupg" --status-fd 1 --output "$tmp/Release" \
    --decrypt "$tmp/InRelease" 2>/dev/null) || true
  grep -q "^\[GNUPG:\] VALIDSIG .*$fpr" <<<"$status" ||
    { echo "ai-arch: $apt is not signed by $fpr"; exit 1; }
  sum=$(awk '/^SHA256:/ {s = 1; next} /^[^ ]/ {s = 0}
    s && $3 == "main/binary-amd64/Packages" {print $1}' "$tmp/Release")
  curl -fsSL -o "$tmp/Packages" "$apt/dists/stable/main/binary-amd64/Packages"
  [[ -n $sum && $(sha256sum <"$tmp/Packages") == "$sum  -" ]] ||
    { echo "ai-arch: the package index of $apt does not match its signed checksum"; exit 1; }
  newest=$(awk -v RS= -v p="$package" '{f = s = n = ""
    for (i = 1; i < NF; i++) {
      if ($i == "Package:" && $(i + 1) == p) n = 1
      if ($i == "Filename:") f = $(i + 1)
      if ($i == "SHA256:") s = $(i + 1)
    }
    if (n && f && s) print f, s}' "$tmp/Packages" | sort -V | tail -n 1)
  [[ -n $newest ]] || { echo "ai-arch: $apt has no $package"; exit 1; }
  deb=${newest% *}
  echo "ai-arch: downloading ${deb##*/}"
  curl -fL --retry 3 -o "$tmp/package.deb" "$apt/$deb"
  [[ $(sha256sum <"$tmp/package.deb") == "${newest#* }  -" ]] ||
    { echo "ai-arch: ${deb##*/} does not match its checksum"; exit 1; }
  # The rename drops the archive's own ./ entry, whose mode, 750 in Chrome's,
  # would otherwise land on / and lock every other user out.
  bsdtar -xOf "$tmp/package.deb" 'data.tar*' | bsdtar -xpf - -C / -s ',^\./$,,'
)

# The app refuses to run as root, so it runs as its own user in sway, which tiles
# it beside Chrome, started the way cage's wiki starts a compositor from systemd.
install_desktop() {
  [[ -e $desktop_ready ]] && return 0
  online || return 1
  pacman -Sy --needed --noconfirm "${desktop_packages[@]}" || return 1
  find /var/cache/pacman/pkg -type f -delete
  install_deb "$desktop_repo/apt/stable" "$desktop_repo/key.asc" "$desktop_key_fpr" claude-desktop || return 1
  install_deb "$chrome_repo/chrome/deb" "$chrome_repo/linux_signing_key.pub" "$chrome_key_fpr" \
    google-chrome-stable || return 1
  install -d /etc/opt/chrome/policies/managed
  cat >/etc/opt/chrome/policies/managed/ai-arch.json <<EOF
{"ExtensionSettings": {"$chrome_extension": {"installation_mode": "force_installed",
  "update_url": "https://clients2.google.com/service/update2/crx", "toolbar_pin": "force_pinned"}}}
EOF

  id "$desktop_user" >/dev/null 2>&1 || useradd -m -G wheel,video,input,audio "$desktop_user" || return 1
  echo "$desktop_user ALL=(ALL:ALL) NOPASSWD: ALL" >/etc/sudoers.d/ai-arch
  chmod 440 /etc/sudoers.d/ai-arch
  install -d -o "$desktop_user" -g "$desktop_user" "/home/$desktop_user/ai-arch" "/home/$desktop_user/.claude" \
    "/home/$desktop_user/.config"
  install -m 644 -o "$desktop_user" -g "$desktop_user" /root/.claude/CLAUDE.md "/home/$desktop_user/.claude/"
  # The app's Google and SSO sign-in opens a browser through xdg-open.
  {
    echo '[Default Applications]'
    printf '%s=google-chrome.desktop\n' text/html x-scheme-handler/http x-scheme-handler/https
  } >"/home/$desktop_user/.config/mimeapps.list"
  chown "$desktop_user:" "/home/$desktop_user/.config/mimeapps.list"

  cat >/etc/pam.d/ai-arch-desktop <<'EOF'
auth     required pam_unix.so nullok
account  required pam_unix.so
session  required pam_unix.so
session  required pam_systemd.so
EOF
  local layout
  layout=$(conf XKB_LAYOUT)
  install -d /etc/sway
  cat >/etc/sway/ai-arch <<EOF
${layout:+input type:keyboard xkb_layout $layout}
exec /usr/bin/claude-desktop --ozone-platform=wayland
exec /usr/bin/google-chrome-stable --ozone-platform=wayland --no-first-run --no-default-browser-check
EOF
  cat >/etc/systemd/system/ai-arch-desktop.service <<EOF
[Unit]
Description=Claude desktop app and Chrome for ai-arch
Wants=dbus.socket systemd-logind.service
After=systemd-user-sessions.service dbus.socket systemd-logind.service getty@tty7.service
Conflicts=getty@tty7.service

[Service]
ExecStart=/usr/bin/sway -c /etc/sway/ai-arch
ExecStartPost=+/usr/bin/chvt 7
User=$desktop_user
WorkingDirectory=/home/$desktop_user/ai-arch
UtmpIdentifier=tty7
UtmpMode=user
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
PAMName=ai-arch-desktop
EOF
  systemctl daemon-reload
  install -d -m 700 "${desktop_ready%/*}"
  touch "$desktop_ready"
}

# The token file on the stick is read once, kept in RAM and removed from the
# stick, so a lost stick no longer carries it.
take_token() {
  [[ ! -s $token_copy && -e /dev/disk/by-label/CIDATA ]] || return 0
  local mnt rw=1
  mnt=$(mktemp -d)
  if ! mount /dev/disk/by-label/CIDATA "$mnt" 2>/dev/null; then
    rw=
    mount -o ro /dev/disk/by-label/CIDATA "$mnt" 2>/dev/null || { rmdir "$mnt"; return 0; }
  fi
  if [[ -s $mnt/token ]]; then
    install -d -m 700 "${token_copy%/*}"
    (umask 077 && cp "$mnt/token" "$token_copy")
    if [[ -n $rw ]]; then
      shred -u "$mnt/token" 2>/dev/null || rm -f "$mnt/token"
    else
      echo "ai-arch: could not remove the token from the stick. Erase the stick after the install."
    fi
  fi
  umount "$mnt"
  rmdir "$mnt"
}

# save-token.sh encrypts the token with gpg when given a passphrase.
use_token() {
  [[ -s $token_copy ]] || return 0
  if [[ $(head -n 1 "$token_copy") == '-----BEGIN PGP MESSAGE-----' ]]; then
    local gnupg pass token=
    gnupg=$(mktemp -d)
    for _ in 1 2 3; do
      read -rsp 'Passphrase of the Claude login token (Enter to skip): ' pass
      echo
      [[ -n $pass ]] || break
      token=$(gpg --homedir "$gnupg" --batch --quiet --pinentry-mode loopback --passphrase-fd 3 \
        --decrypt "$token_copy" 3<<<"$pass" 2>/dev/null) && break
      echo 'ai-arch: that passphrase does not open the token.'
    done
    gpgconf --homedir "$gnupg" --kill all 2>/dev/null
    rm -rf "$gnupg"
    [[ -n $token ]] || return 0
    (umask 077 && printf '%s\n' "$token" >"$token_copy")
  fi
  CLAUDE_CODE_OAUTH_TOKEN=$(<"$token_copy")
  export CLAUDE_CODE_OAUTH_TOKEN
}

login_hint() {
  local addrs
  addrs=$(ip -4 -br addr show scope global 2>/dev/null | awk '{sub(/\/.*/, "", $3); print $3}' | paste -sd' ' -)
  cat <<EOF

Claude will show a login link, and this console cannot copy it.
The easy way is to log in from another device on the same network:

    ssh root@archiso.local        (or root@ one of: ${addrs:-no address yet})

and type ai-arch there.
EOF
  if [[ ! -s /root/.ssh/authorized_keys ]]; then
    echo "This stick has no SSH key, so first set a root password here with: passwd"
  fi
  echo
  read -rp 'Press Enter to log in on this console anyway, or Ctrl+C to stop. ' _
}

if [[ ${1:-} == --prepare ]]; then
  take_token
  if ! install_claude >/var/log/ai-arch-prepare.log 2>&1; then
    wall 'ai-arch: no internet yet. Plug in a cable or connect with iwctl, then type ai-arch.'
  elif install_desktop >>/var/log/ai-arch-prepare.log 2>&1; then
    systemctl start --no-block ai-arch-desktop
  else
    wall 'ai-arch: the desktop app did not install; see /var/log/ai-arch-prepare.log. Type ai-arch --console to use Claude Code here.'
  fi
  exit 0
fi

cloud-init status --wait >/dev/null 2>&1
until install_claude; do
  echo 'ai-arch: no internet. Plug in a cable, or connect to Wi-Fi with iwctl.'
  read -rp 'Press Enter to try again, or Ctrl+C to stop. ' _
done

if [[ ${1:-} != --console ]]; then
  install_desktop || { echo 'ai-arch: the desktop app did not install. Type ai-arch --console to use Claude Code here.'; exit 1; }
  systemctl restart ai-arch-desktop
  exit 0
fi

take_token
use_token
if [[ -z ${CLAUDE_CODE_OAUTH_TOKEN:-} && -z ${SSH_CONNECTION:-} && ! -s /root/.claude/.credentials.json ]]; then
  login_hint
fi

mkdir -p "$workdir"
cd "$workdir" || exit 1
exec claude "Install Arch Linux on this machine."
